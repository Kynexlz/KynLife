local Library = loadstring(game:HttpGet("https://raw.githubusercontent.com/Kynexlz/KynLife/refs/heads/main/Source"))()

local Window = Library:CreateWindow("Kynexlz Hub")

local FarmingPage = Window:addPage("Farming", 4, false, 6)

local BenchPressEnabled = false

FarmingPage:addToggle("BenchPress", function(state)
    BenchPressEnabled = state

    if state then
        task.spawn(function()
            while BenchPressEnabled do
                for i = 1, 100 do
                    if not BenchPressEnabled then
                        break
                    end

                    local Remotes = game:GetService("ReplicatedStorage").Remotes
                    Remotes.Bench:FireServer()
                    Remotes.PushUp:FireServer()
                    task.wait()
                end
            end
        end)
    end
end)

local DumbbellEnabled = false

FarmingPage:addToggle("Dumbbell", function(state)
    DumbbellEnabled = state

    if state then
        task.spawn(function()
            local Remotes = game:GetService("ReplicatedStorage").Remotes

            while DumbbellEnabled do
                Remotes.Dumbell:FireServer("Rep", 1)
                task.wait()
            end
        end)
    end
end)

local PushUpEnabled = false

FarmingPage:addToggle("PushUp", function(state)
    PushUpEnabled = state

    if state then
        task.spawn(function()
            local PushUpRemote = game:GetService("ReplicatedStorage").Remotes.PushUp

            while PushUpEnabled do
                PushUpRemote:FireServer()
                task.wait()
            end
        end)
    end
end)

